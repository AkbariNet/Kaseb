<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" 
            xmlns:LoginChildren="clr-namespace:Kaseb.Views.LoginChildren"
             xmlns:Models="clr-namespace:KasebCore.Models;assembly=KasebCore"
              xmlns:Childrens="clr-namespace:Kaseb.Views.Lobby_Childrens"
             x:Class="Kaseb.Views.Login"
             Title="Login">
    <Border Margin="0,40,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="80" ></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">
                <LoginChildren:LoginMainPage x:Name="MainPage"/>
                <LoginChildren:LoginGetCode x:Name="GetCodePage" IsVisible="False"></LoginChildren:LoginGetCode>
            </Grid>
            <Childrens:MenuAPP Grid.Row="2" />
        </Grid>
    </Border>
</ContentPage>