<?xml version="1.0" encoding="utf-8" ?>
<material:ButtonView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:Models="clr-namespace:KasebCore.Models;assembly=KasebCore" BackgroundColor="Transparent"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" 
             x:Class="Kaseb.Views.Element.Buttons.HamburgerMenuItem" x:Name="HambugrgerMenuItem" 
             HeightRequest="80" 
             >
    <Border Background="{ AppThemeBinding Dark={DynamicResource Black}, Light={DynamicResource White}}"
             StrokeShape="RoundRectangle 20" Margin="0,0,0,0" StrokeThickness="0" Stroke="Transparent">
        <StackLayout Margin="20,0" VerticalOptions="Center" Spacing="5">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Image Source="{Binding Icon}" 
HorizontalOptions="Start"
Margin="0,0,0,0"
Opacity="1"/>
                <Label Text="{Binding Title}"
               FontSize="16"
               FontFamily="VazirmatnBold"/>
            </StackLayout>

            <Label Text="{Binding Description}"
               FontSize="12"
               FontFamily="VazirmatnLight"
               />
        </StackLayout>

    </Border>
</material:ButtonView>