<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material" 
            StrokeShape="RoundRectangle 20"
             xmlns:Models="clr-namespace:KasebCore.Models;assembly=KasebCore"
              xmlns:Childrens="clr-namespace:Kaseb.Views.Lobby_Childrens"
        Background="{AppThemeBinding Light={DynamicResource TinyWhite} , Dark={DynamicResource TinyDark}}"
        Padding="20" Margin="15,20,15,15"
             x:Class="Kaseb.Views.LoginChildren.LoginGetCode"
             >

            
                <StackLayout Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
               
                    <StackLayout  HorizontalOptions="Center" Spacing="20">
                        <Image Source="{FontImageSource Glyph={x:Static Models:FontAwsomeIconLoader.UserCheck},
                         Size=36, FontFamily=7Awesome, Color={AppThemeBinding Light={DynamicResource Gray950},
                         Dark={StaticResource White}}}"/>
                        <Label Text="احراز هویت"
                             HorizontalOptions="Center"
                             FontSize="24"
                             FontFamily="VazirmatnBold"/>
                        <Label Text="لطفا کد تایید ارسال شده به شماره وارد شده را وارد نمایید."
               FontSize="16"
                             HorizontalOptions="Center"
               FontFamily="VazirmatnLight"/>
                        <Label x:Name="Debug" Text="کد تایید:"
FontSize="16"
              HorizontalOptions="Center"
FontFamily="VazirmatnLight"/>
                    </StackLayout>
                    <ScrollView>
                        <StackLayout Spacing="20" >
                <Grid  ColumnDefinitions="*,5,*,5,*,5,*,5,*">
                    <Border 
      Background="{AppThemeBinding
      Light={DynamicResource Gray100},
      Dark={DynamicResource Gray900}}"
      StrokeShape="RoundRectangle 10">
                                    <material:TextField
                                        AllowClear="True"
                                        x:Name="PhoneNumberText"
                                        Keyboard="Telephone"
                                        
                                        />

                        </Border>
                        <Border 
      Background="{AppThemeBinding
      Light={DynamicResource Gray100},
      Dark={DynamicResource Gray900}}"
      StrokeShape="RoundRectangle 10">
                            <material:TextField
                                MaxLength="1"
                                x:Name="CodeChar5"
                                        Keyboard="Telephone"
                                        
                                        />

                        </Border>
                        <Border 
      Background="{AppThemeBinding
      Light={DynamicResource Gray100},
      Dark={DynamicResource Gray900}}"
      StrokeShape="RoundRectangle 10"
                            Grid.Column="2">
                            <material:TextField
                                MaxLength="1"
                                x:Name="CodeChar4"
                                        Keyboard="Telephone"
                                        
                                        />

                        </Border>
                        <Border 
      Background="{AppThemeBinding
      Light={DynamicResource Gray100},
      Dark={DynamicResource Gray900}}"
      StrokeShape="RoundRectangle 10"
                            Grid.Column="4">
                            <material:TextField
                                MaxLength="1"
                                x:Name="CodeChar3"
                                        Keyboard="Telephone"
                                        
                                        />

                        </Border>
                    <Border 
      Background="{AppThemeBinding
      Light={DynamicResource Gray100},
      Dark={DynamicResource Gray900}}"
      StrokeShape="RoundRectangle 10"
                        Grid.Column="6">
                        <material:TextField
                            MaxLength="1"
                            x:Name="CodeChar2"
                                        Keyboard="Telephone"
                                        
                                        />

                    </Border>
                    <Border 
Background="{AppThemeBinding
Light={DynamicResource Gray100},
Dark={DynamicResource Gray900}}"
StrokeShape="RoundRectangle 10"
                  Grid.Column="8">
                        <material:TextField
                            MaxLength="1"
                            x:Name="CodeChar1"
                                  Keyboard="Telephone"
                                  
                                  />

                    </Border>
                </Grid>
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="10">
                    <Button Text="ورود" WidthRequest="100"
                            TextColor="White"
                            Clicked="Button_Clicked"/>

                    <Button Text="بازگشت" WidthRequest="100" 
                            x:Name="BackButton"
                            Clicked="BackButton_Clicked"
                            Background="Transparent"
                            TextColor="{AppThemeBinding 
                        Dark={DynamicResource White}
                        , Light={DynamicResource Black}}"/>
                </StackLayout>
                          </StackLayout>
                    </ScrollView>
                </StackLayout>
           

</Border>